{
  "elevation": {
    "0": {
      "boxShadow": "none"
    },
    "1": {
      "boxShadow": "0px 1px 2px rgba(0, 0, 0, 0.05), 0px 1px 3px rgba(0, 0, 0, 0.1)"
    },
    "2": {
      "boxShadow": "0px 2px 4px rgba(0, 0, 0, 0.07), 0px 2px 8px rgba(0, 0, 0, 0.12)"
    },
    "4": {
      "boxShadow": "0px 4px 8px rgba(0, 0, 0, 0.08), 0px 4px 16px rgba(0, 0, 0, 0.14)"
    },
    "8": {
      "boxShadow": "0px 8px 16px rgba(0, 0, 0, 0.1), 0px 8px 32px rgba(0, 0, 0, 0.16)"
    },
    "16": {
      "boxShadow": "0px 16px 32px rgba(0, 0, 0, 0.12), 0px 16px 64px rgba(0, 0, 0, 0.18)"
    }
  },
  "special": {
    "card": {
      "boxShadow": "0px 1px 3px rgba(0, 0, 0, 0.1), 0px 1px 2px rgba(0, 0, 0, 0.06)"
    },
    "dropdown": {
      "boxShadow": "0px 4px 6px rgba(0, 0, 0, 0.1), 0px 2px 4px rgba(0, 0, 0, 0.06)"
    },
    "modal": {
      "boxShadow": "0px 20px 25px -5px rgba(0, 0, 0, 0.1), 0px 10px 10px -5px rgba(0, 0, 0, 0.04)"
    }
  }
}