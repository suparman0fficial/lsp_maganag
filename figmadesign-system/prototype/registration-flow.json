{
  "componentName": "Participant Registration Flow",
  "description": "Complete interactive prototype flow for participant registration",
  "flow": {
    "name": "Registration Journey",
    "startPoint": "Landing Page Hero CTA",
    "endPoint": "Registration Success Confirmation",
    "estimatedTime": "5-10 minutes",
    "screens": [
      {
        "id": "landing-hero",
        "name": "Landing Page - Hero Section",
        "description": "Hero section with main CTA",
        "interactions": [
          {
            "element": "cta-button-register",
            "type": "click",
            "action": "navigateTo: registration-page",
            "animation": "button-click-ripple"
          },
          {
            "element": "cta-button-schemes",
            "type": "click",
            "action": "scrollTo: schemes-section",
            "animation": "smooth-scroll"
          }
        ],
        "animations": {
          "hero-title": "fadeInUp 0.8s ease-out",
          "hero-subtitle": "fadeInUp 0.8s ease-out 0.2s",
          "cta-buttons": "fadeInUp 0.8s ease-out 0.4s",
          "hero-image": "fadeInRight 0.8s ease-out 0.3s",
          "floating-cards": "float 3s ease-in-out infinite"
        }
      },
      {
        "id": "registration-page",
        "name": "Registration Page",
        "description": "Multi-step registration wizard",
        "components": ["progress-stepper", "registration-form"],
        "interactions": [
          {
            "element": "progress-step-1",
            "type": "click",
            "action": "navigateToStep: 1",
            "animation": "step-activate"
          },
          {
            "element": "progress-step-2",
            "type": "click",
            "action": "navigateToStep: 2 (if step 1 complete)",
            "animation": "step-activate"
          },
          {
            "element": "progress-step-3",
            "type": "click",
            "action": "navigateToStep: 3 (if step 2 complete)",
            "animation": "step-activate"
          }
        ]
      },
      {
        "id": "step-1-personal-data",
        "name": "Step 1: Personal Data",
        "description": "Personal information form",
        "interactions": [
          {
            "element": "form-field-focus",
            "type": "focus",
            "action": "field-activate",
            "animation": "field-glow"
          },
          {
            "element": "form-field-blur",
            "type": "blur",
            "action": "field-validate",
            "animation": "field-normalize"
          },
          {
            "element": "next-button",
            "type": "click",
            "action": "validateAndProceed: step2",
            "animation": "slideNext"
          },
          {
            "element": "dropdown-scheme",
            "type": "click",
            "action": "toggleDropdown",
            "animation": "dropdown-expand"
          }
        ],
        "validationStates": {
          "field-valid": {
            "borderColor": "#4CAF50",
            "icon": "check_circle",
            "animation": "success-bounce"
          },
          "field-invalid": {
            "borderColor": "#F44336",
            "icon": "error",
            "message": "Error message appears",
            "animation": "shake-error"
          },
          "field-empty": {
            "borderColor": "#DADCE0",
            "icon": "none"
          }
        }
      },
      {
        "id": "step-2-document-upload",
        "name": "Step 2: Document Upload",
        "description": "Document upload with drag-and-drop",
        "interactions": [
          {
            "element": "upload-area",
            "type": "dragEnter",
            "action": "highlight-dropzone",
            "animation": "dropzone-active"
          },
          {
            "element": "upload-area",
            "type": "dragLeave",
            "action": "normalize-dropzone",
            "animation": "dropzone-normal"
          },
          {
            "element": "upload-area",
            "type": "drop",
            "action": "processFile",
            "animation": "file-drop-bounce"
          },
          {
            "element": "browse-button",
            "type": "click",
            "action": "openFileDialog",
            "animation": "button-press"
          },
          {
            "element": "file-preview",
            "type": "hover",
            "action": "showFileActions",
            "animation": "file-options-fade"
          },
          {
            "element": "remove-file",
            "type": "click",
            "action": "removeFile",
            "animation": "file-slide-out"
          }
        ],
        "uploadStates": {
          "uploading": {
            "progressBar": true,
            "percentage": "0-100%",
            "icon": "hourglass_empty",
            "animation": "progress-pulse"
          },
          "success": {
            "progressBar": false,
            "icon": "check_circle",
            "backgroundColor": "#E6F4EA",
            "animation": "success-checkmark"
          },
          "error": {
            "progressBar": false,
            "icon": "error",
            "backgroundColor": "#FFEBEE",
            "message": "Upload failed",
            "animation": "error-shake"
          },
          "processing": {
            "progressBar": false,
            "icon": "autorenew",
            "animation": "spin-icon"
          }
        }
      },
      {
        "id": "step-3-confirmation",
        "name": "Step 3: Review & Confirm",
        "description": "Review data and submit registration",
        "interactions": [
          {
            "element": "edit-section",
            "type": "click",
            "action": "navigateToEditStep",
            "animation": "slide-to-step"
          },
          {
            "element": "agreement-checkbox",
            "type": "click",
            "action": "toggleAgreement",
            "animation": "checkbox-check"
          },
          {
            "element": "submit-button",
            "type": "click",
            "action": "submitRegistration",
            "animation": "button-loading then success"
          }
        ],
        "checkboxAnimations": {
          "unchecked": "scale(1) rotate(0deg)",
          "checking": "scale(1.2) rotate(360deg)",
          "checked": "scale(1) rotate(0deg)"
        }
      },
      {
        "id": "success-modal",
        "name": "Registration Success Modal",
        "description": "Success confirmation modal",
        "interactions": [
          {
            "element": "modal-overlay",
            "type": "click",
            "action": "closeModal",
            "animation": "modal-fade-out"
          },
          {
            "element": "close-button",
            "type": "click",
            "action": "closeModal",
            "animation": "modal-slide-up"
          },
          {
            "element": "view-status-button",
            "type": "click",
            "action": "navigateTo: dashboard",
            "animation": "page-transition"
          },
          {
            "element": "download-receipt",
            "type": "click",
            "action": "downloadRegistrationProof",
            "animation": "download-bounce"
          }
        ],
        "modalAnimations": {
          "entrance": {
            "overlay": "fadeIn 0.3s ease-out",
            "modal": "scaleIn 0.3s ease-out",
            "icon": "bounceIn 0.6s ease-out",
            "content": "fadeInUp 0.4s ease-out 0.2s"
          },
          "exit": {
            "overlay": "fadeOut 0.3s ease-out",
            "modal": "scaleOut 0.3s ease-out"
          }
        }
      }
    ]
  },
  "microInteractions": {
    "buttonHover": {
      "scale": "1.05",
      "shadow": "0 4px 12px rgba(10, 61, 98, 0.3)",
      "duration": "0.2s",
      "easing": "ease-out"
    },
    "buttonPress": {
      "scale": "0.98",
      "duration": "0.1s",
      "easing": "ease-in"
    },
    "fieldFocus": {
      "borderColor": "#0A3D62",
      "boxShadow": "0 0 0 4px rgba(10, 61, 98, 0.1)",
      "duration": "0.2s"
    },
    "cardHover": {
      "transform": "translateY(-4px)",
      "shadow": "0 8px 24px rgba(0, 0, 0, 0.12)",
      "duration": "0.3s"
    },
    "progressStepActive": {
      "scale": "1.1",
      "borderColor": "#0A3D62",
      "boxShadow": "0 0 0 8px rgba(10, 61, 98, 0.1)",
      "duration": "0.3s"
    },
    "successCheckmark": {
      "pathAnimation": "draw-path 0.6s ease-out",
      "scale": "scale 0.6s ease-out"
    },
    "errorShake": {
      "animation": "shake 0.5s ease-in-out",
      "keyframes": [
        { "transform": "translateX(0)" },
        { "transform": "translateX(-10px)" },
        { "transform": "translateX(10px)" },
        { "transform": "translateX(-10px)" },
        { "transform": "translateX(0)" }
      ]
    },
    "loadingSpinner": {
      "animation": "spin 1s linear infinite",
      "transformOrigin": "center"
    }
  },
  "transitions": {
    "pageTransition": {
      "type": "slide-right",
      "duration": "0.4s",
      "easing": "ease-out"
    },
    "stepTransition": {
      "type": "slide-up",
      "duration": "0.3s",
      "easing": "ease-out"
    },
    "modalTransition": {
      "type": "scale-fade",
      "duration": "0.3s",
      "easing": "ease-out"
    },
    "sidebarTransition": {
      "type": "slide-left",
      "duration": "0.3s",
      "easing": "ease-in-out"
    },
    "dropdownTransition": {
      "type": "expand-down",
      "duration": "0.2s",
      "easing": "ease-out"
    },
    "tooltipTransition": {
      "type": "fade-scale",
      "duration": "0.15s",
      "easing": "ease-out"
    }
  },
  "loadingStates": {
    "buttonLoading": {
      "text": "Memproses...",
      "icon": "hourglass_empty",
      "iconAnimation": "spin",
      "disabled": true,
      "showProgress": false
    },
    "formSubmitting": {
      "overlay": true,
      "spinner": true,
      "message": "Sedang mengirim data...",
      "preventClose": true
    },
    "fileUploading": {
      "progressBar": true,
      "percentage": true,
      "cancelButton": true,
      "status": "Uploading..."
    },
    "dataLoading": {
      "skeleton": true,
      "shimmer": true,
      "placeholderCount": 3
    }
  },
  "errorHandling": {
    "formValidation": {
      "inlineErrors": true,
      "fieldHighlight": true,
      "scrollToError": true,
      "errorMessage": {
        "required": "Field ini wajib diisi",
        "invalid": "Format tidak valid",
        "minLength": "Minimal {min} karakter",
        "maxLength": "Maksimal {max} karakter",
        "email": "Format email tidak valid",
        "phone": "Format nomor telepon tidak valid"
      }
    },
    "networkErrors": {
      "retryButton": true,
      "message": "Terjadi kesalahan koneksi. Silakan coba lagi.",
      "autoRetry": false
    },
    "serverErrors": {
      "message": "Terjadi kesalahan pada server. Silakan coba lagi nanti.",
      "contactSupport": true
    }
  },
  "accessibility": {
    "keyboardNavigation": {
      "tabOrder": "logical",
      "focusIndicators": "visible",
      "skipLinks": true
    },
    "screenReader": {
      "ariaLabels": "descriptive",
      "ariaLive": "polite for changes",
      "roleAttributes": "semantic"
    },
    "colorContrast": {
      "textContrast": "4.5:1 minimum",
      "interactiveElements": "3:1 minimum"
    },
    "reducedMotion": {
      "respectPreference": true,
      "essentialOnly": true
    }
  },
  "responsiveBehavior": {
    "mobile": {
      "breakpoint": "768px",
      "adaptations": {
        "formLayout": "singleColumn",
        "buttonSize": "larger",
        "touchTargets": "44px minimum",
        "stepperVariant": "vertical",
        "modalFullWidth": true
      }
    },
    "tablet": {
      "breakpoint": "1024px",
      "adaptations": {
        "formLayout": "twoColumn",
        "stepperVariant": "horizontal",
        "sidebarOverlay": true
      }
    },
    "desktop": {
      "breakpoint": "1440px",
      "adaptations": {
        "maxContentWidth": "1200px",
        "sidebarFixed": true,
        "hoverStates": "enabled"
      }
    }
  },
  "userTesting": {
    "scenarios": [
      {
        "name": "First-time Registration",
        "description": "New user completing registration for the first time",
        "successCriteria": [
          "Completes all 3 steps within 10 minutes",
          "Understands progress indicator",
          "Successfully uploads required documents",
          "Receives confirmation"
        ]
      },
      {
        "name": "Returning User with Draft",
        "description": "User returning to complete a saved draft registration",
        "successCriteria": [
          "Finds previously saved data",
          "Can continue from where left off",
          "Completes remaining steps"
        ]
      },
      {
        "name": "Error Recovery",
        "description": "User encountering and recovering from validation errors",
        "successCriteria": [
          "Understands error messages",
          "Can correct validation issues",
          "Successfully submits after fixes"
        ]
      }
    ],
    "metrics": {
      "completionRate": "target: >80%",
      "timeToComplete": "target: <10 minutes",
      "errorRate": "target: <15%",
      "satisfactionScore": "target: >4.0/5.0"
    }
  }
}