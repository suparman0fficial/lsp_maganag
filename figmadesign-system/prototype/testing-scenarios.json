  "iterationPlan": {
    "round1": {
      "focus": "Critical paths and major usability issues",
      "participants": 5-7,
      "changes": "Quick fixes, major flow improvements"
    },
    "round2": {
      "focus": "Refined interactions and edge cases",
      "participants": 7-10,
      "changes": "Interaction refinements, content improvements"
    },
    "round3": {
      "focus": "Validation and accessibility",
      "participants": 10-15,
      "changes": "Final polish, accessibility improvements"
    }
  },
