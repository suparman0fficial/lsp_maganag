{
  "componentName": "Dashboard Layout",
  "description": "Main dashboard layout with sidebar, topbar, and content area",
  "variants": {
    "participant": {
      "container": {
        "display": "flex",
        "minHeight": "100vh",
        "backgroundColor": "#F5F6FA"
      },
      "sidebar": {
        "width": "250px",
        "position": "fixed",
        "left": "0px",
        "top": "0px",
        "height": "100vh",
        "zIndex": "100"
      },
      "content": {
        "marginLeft": "250px",
        "flex": "1",
        "minHeight": "100vh"
      }
    },
    "admin": {
      "container": {
        "display": "flex",
        "minHeight": "100vh",
        "backgroundColor": "#F5F6FA"
      },
      "topbar": {
        "height": "72px",
        "position": "fixed",
        "top": "0px",
        "left": "0px",
        "right": "0px",
        "zIndex": "100"
      },
      "sidebar": {
        "width": "280px",
        "position": "fixed",
        "left": "0px",
        "top": "72px",
        "height": "calc(100vh - 72px)",
        "zIndex": "99"
      },
      "content": {
        "marginLeft": "280px",
        "marginTop": "72px",
        "flex": "1",
        "minHeight": "calc(100vh - 72px)"
      }
    }
  },
  "contentArea": {
    "container": {
      "padding": "32px"
    },
    "pageHeader": {
      "marginBottom": "32px"
    },
    "pageTitle": {
      "fontFamily": "Poppins",
      "fontSize": "32px",
      "fontWeight": "600",
      "color": "#1A1A1A",
      "margin": "0px 0px 8px 0px"
    },
    "pageSubtitle": {
      "fontFamily": "Roboto",
      "fontSize": "16px",
      "fontWeight": "400",
      "color": "#5F6368",
      "margin": "0px"
    },
    "breadcrumb": {
      "display": "flex",
      "alignItems": "center",
      "gap": "8px",
      "marginBottom": "24px"
    },
    "breadcrumbItem": {
      "fontFamily": "Roboto",
      "fontSize": "14px",
      "fontWeight": "500",
      "color": "#5F6368",
      "textDecoration": "none"
    },
    "breadcrumbActive": {
      "color": "#0A3D62",
      "fontWeight": "600"
    },
    "breadcrumbSeparator": {
      "color": "#9AA0A6"
    }
  },
  "gridSystem": {
    "container": {
      "display": "grid",
      "gap": "24px"
    },
    "grid12": {
      "gridTemplateColumns": "repeat(12, 1fr)"
    },
    "grid6": {
      "gridTemplateColumns": "repeat(6, 1fr)"
    },
    "grid4": {
      "gridTemplateColumns": "repeat(4, 1fr)"
    },
    "grid3": {
      "gridTemplateColumns": "repeat(3, 1fr)"
    },
    "grid2": {
      "gridTemplateColumns": "repeat(2, 1fr)"
    },
    "span12": {
      "gridColumn": "span 12"
    },
    "span6": {
      "gridColumn": "span 6"
    },
    "span4": {
      "gridColumn": "span 4"
    },
    "span3": {
      "gridColumn": "span 3"
    },
    "span2": {
      "gridColumn": "span 2"
    }
  },
  "responsive": {
    "mobile": {
      "content": {
        "marginLeft": "0px",
        "marginTop": "64px",
        "padding": "16px"
      },
      "adminContent": {
        "marginLeft": "0px",
        "padding": "16px"
      },
      "gridSystem": {
        "grid12": {
          "gridTemplateColumns": "1fr"
        },
        "grid6": {
          "gridTemplateColumns": "1fr"
        },
        "grid4": {
          "gridTemplateColumns": "repeat(2, 1fr)"
        },
        "grid3": {
          "gridTemplateColumns": "repeat(2, 1fr)"
        },
        "grid2": {
          "gridTemplateColumns": "1fr"
        },
        "span12": {
          "gridColumn": "span 1"
        },
        "span6": {
          "gridColumn": "span 1"
        },
        "span4": {
          "gridColumn": "span 1"
        },
        "span3": {
          "gridColumn": "span 1"
        },
        "span2": {
          "gridColumn": "span 1"
        }
      }
    },
    "tablet": {
      "gridSystem": {
        "grid12": {
          "gridTemplateColumns": "repeat(6, 1fr)"
        },
        "grid6": {
          "gridTemplateColumns": "repeat(3, 1fr)"
        },
        "grid4": {
          "gridTemplateColumns": "repeat(3, 1fr)"
        },
        "grid3": {
          "gridTemplateColumns": "repeat(2, 1fr)"
        }
      }
    }
  }
}