{
  "componentName": "Registration Form",
  "description": "Multi-step registration form wizard with validation",
  "variants": {
    "container": {
      "backgroundColor": "#FFFFFF",
      "borderRadius": "16px",
      "boxShadow": "0px 4px 12px rgba(0, 0, 0, 0.08)",
      "maxWidth": "800px",
      "margin": "0px auto",
      "overflow": "hidden"
    },
    "stepContainer": {
      "padding": "32px",
      "minHeight": "500px"
    }
  },
  "steps": {
    "step1": {
      "title": "Data Diri",
      "description": "Lengkapi informasi personal Anda",
      "fields": [
        {
          "type": "text",
          "label": "Nama Lengkap",
          "placeholder": "Masukkan nama lengkap sesuai KTP",
          "required": true,
          "validation": "min:3|max:100"
        },
        {
          "type": "email",
          "label": "Email",
          "placeholder": "email@example.com",
          "required": true,
          "validation": "email"
        },
        {
          "type": "tel",
          "label": "Nomor Telepon",
          "placeholder": "+62 812-3456-7890",
          "required": true,
          "validation": "phone"
        },
        {
          "type": "select",
          "label": "Jenis Kelamin",
          "placeholder": "Pilih jenis kelamin",
          "required": true,
          "options": ["Laki-laki", "Perempuan"]
        },
        {
          "type": "date",
          "label": "Tanggal Lahir",
          "required": true,
          "validation": "age:18"
        },
        {
          "type": "textarea",
          "label": "Alamat Lengkap",
          "placeholder": "Masukkan alamat lengkap",
          "required": true,
          "rows": 3
        }
      ]
    },
    "step2": {
      "title": "Upload Dokumen",
      "description": "Upload dokumen persyaratan sertifikasi",
      "fields": [
        {
          "type": "file",
          "label": "Pas Foto Terbaru",
          "description": "Format: JPG/PNG, Maks: 2MB, Ukuran: 4x6cm",
          "required": true,
          "accept": ".jpg,.jpeg,.png",
          "maxSize": "2MB",
          "preview": true
        },
        {
          "type": "file",
          "label": "Ijazah Terakhir",
          "description": "Format: PDF, Maks: 5MB",
          "required": true,
          "accept": ".pdf",
          "maxSize": "5MB"
        },
        {
          "type": "file",
          "label": "KTP",
          "description": "Format: PDF/JPG, Maks: 3MB",
          "required": true,
          "accept": ".pdf,.jpg,.jpeg",
          "maxSize": "3MB"
        },
        {
          "type": "file",
          "label": "Surat Pengalaman Kerja",
          "description": "Format: PDF, Maks: 5MB",
          "required": false,
          "accept": ".pdf",
          "maxSize": "5MB"
        },
        {
          "type": "file",
          "label": "Sertifikat Pendukung",
          "description": "Format: PDF, Maks: 5MB (Boleh lebih dari 1)",
          "required": false,
          "accept": ".pdf",
          "maxSize": "5MB",
          "multiple": true
        }
      ]
    },
    "step3": {
      "title": "Konfirmasi",
      "description": "Review dan konfirmasi data Anda",
      "sections": [
        {
          "title": "Data Pribadi",
          "fields": ["nama", "email", "telepon", "jenisKelamin", "tanggalLahir", "alamat"]
        },
        {
          "title": "Dokumen yang Diupload",
          "fields": ["pasFoto", "ijazah", "ktp", "suratPengalaman", "sertifikat"]
        },
        {
          "title": "Skema Sertifikasi",
          "fields": ["skema", "biaya", "jadwal"]
        }
      ]
    }
  },
  "fileUpload": {
    "container": {
      "borderWidth": "2px",
      "borderStyle": "dashed",
      "borderColor": "#DADCE0",
      "borderRadius": "12px",
      "padding": "32px",
      "textAlign": "center",
      "backgroundColor": "#F8F9FA",
      "transition": "all 0.3s ease",
      "cursor": "pointer",
      "position": "relative"
    },
    "hover": {
      "borderColor": "#0A3D62",
      "backgroundColor": "#E8F0FE"
    },
    "dragOver": {
      "borderColor": "#0A3D62",
      "backgroundColor": "#E8F0FE"
    },
    "uploading": {
      "borderColor": "#FFC107",
      "backgroundColor": "#FFF8E1"
    },
    "success": {
      "borderColor": "#4CAF50",
      "backgroundColor": "#E6F4EA"
    },
    "error": {
      "borderColor": "#F44336",
      "backgroundColor": "#FFEBEE"
    },
    "icon": {
      "width": "48px",
      "height": "48px",
      "color": "#9AA0A6",
      "marginBottom": "16px"
    },
    "title": {
      "fontFamily": "Roboto",
      "fontSize": "18px",
      "fontWeight": "600",
      "color": "#202124",
      "marginBottom": "8px"
    },
    "subtitle": {
      "fontFamily": "Roboto",
      "fontSize": "14px",
      "fontWeight": "400",
      "color": "#5F6368",
      "marginBottom": "16px"
    },
    "button": {
      "backgroundColor": "#0A3D62",
      "color": "#FFFFFF",
      "padding": "10px 20px",
      "borderRadius": "8px",
      "borderWidth": "0px",
      "fontFamily": "Roboto",
      "fontSize": "14px",
      "fontWeight": "500",
      "cursor": "pointer"
    },
    "fileList": {
      "marginTop": "24px"
    },
    "fileItem": {
      "display": "flex",
      "alignItems": "center",
      "justifyContent": "space-between",
      "padding": "12px 16px",
      "backgroundColor": "#FFFFFF",
      "borderRadius": "8px",
      "borderWidth": "1px",
      "borderColor": "#DADCE0",
      "marginBottom": "8px"
    },
    "fileInfo": {
      "display": "flex",
      "alignItems": "center",
      "gap": "12px"
    },
    "fileIcon": {
      "width": "24px",
      "height": "24px",
      "color": "#5F6368"
    },
    "fileName": {
      "fontFamily": "Roboto",
      "fontSize": "14px",
      "fontWeight": "500",
      "color": "#202124"
    },
    "fileSize": {
      "fontFamily": "Roboto",
      "fontSize": "12px",
      "fontWeight": "400",
      "color": "#5F6368",
      "marginLeft": "8px"
    },
    "removeButton": {
      "backgroundColor": "transparent",
      "borderWidth": "0px",
      "color": "#F44336",
      "cursor": "pointer",
      "padding": "4px"
    }
  },
  "formActions": {
    "container": {
      "display": "flex",
      "justifyContent": "space-between",
      "padding": "24px 32px",
      "borderTop": "1px solid #DADCE0",
      "backgroundColor": "#F8F9FA"
    },
    "backButton": {
      "backgroundColor": "transparent",
      "color": "#5F6368",
      "borderWidth": "2px",
      "borderColor": "#DADCE0",
      "padding": "12px 24px",
      "borderRadius": "8px",
      "fontFamily": "Roboto",
      "fontSize": "16px",
      "fontWeight": "500",
      "cursor": "pointer"
    },
    "nextButton": {
      "backgroundColor": "#0A3D62",
      "color": "#FFFFFF",
      "borderWidth": "0px",
      "padding": "12px 32px",
      "borderRadius": "8px",
      "fontFamily": "Roboto",
      "fontSize": "16px",
      "fontWeight": "500",
      "cursor": "pointer"
    },
    "submitButton": {
      "backgroundColor": "#4CAF50",
      "color": "#FFFFFF",
      "borderWidth": "0px",
      "padding": "12px 32px",
      "borderRadius": "8px",
      "fontFamily": "Roboto",
      "fontSize": "16px",
      "fontWeight": "500",
      "cursor": "pointer"
    }
  },
  "validation": {
    "error": {
      "fontFamily": "Roboto",
      "fontSize": "12px",
      "fontWeight": "400",
      "color": "#F44336",
      "marginTop": "4px"
    },
    "success": {
      "fontFamily": "Roboto",
      "fontSize": "12px",
      "fontWeight": "400",
      "color": "#4CAF50",
      "marginTop": "4px"
    }
  }
}