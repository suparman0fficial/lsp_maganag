    "title": {
      "fontFamily": "Poppins",
      "fontSize": "20px",
      "fontWeight": "600",
      "color": "#1A1A1A",
      "marginBottom": "4px"
    },
    "subtitle": {
      "fontFamily": "Roboto",
      "fontSize": "14px",
      "fontWeight": "400",
      "color": "#5F6368"
    }
  },
  "content": {
    "default": {
      "fontFamily": "Roboto",
      "fontSize": "16px",
      "fontWeight": "400",
      "color": "#202124",
      "lineHeight": "1.6"
    }
  },
  "footer": {
    "default": {
      "marginTop": "24px",
      "paddingTop": "16px",
      "borderTop": "1px solid #F5F6FA"
