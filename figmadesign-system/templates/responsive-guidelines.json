{
  "componentName": "Responsive Guidelines",
  "description": "Comprehensive responsive design guidelines for all components",
  "breakpoints": {
    "mobile": {
      "name": "Mobile",
      "minWidth": "320px",
      "maxWidth": "767px",
      "containerPadding": "16px",
      "gridColumns": 4,
      "typeScale": "mobile"
    },
    "tablet": {
      "name": "Tablet",
      "minWidth": "768px",
      "maxWidth": "1023px",
      "containerPadding": "24px",
      "gridColumns": 8,
      "typeScale": "tablet"
    },
    "desktop": {
      "name": "Desktop",
      "minWidth": "1024px",
      "maxWidth": "1439px",
      "containerPadding": "32px",
      "gridColumns": 12,
      "typeScale": "desktop"
    },
    "large": {
      "name": "Large Desktop",
      "minWidth": "1440px",
      "containerPadding": "48px",
      "gridColumns": 12,
      "typeScale": "desktop"
    }
  },
  "typeScale": {
    "mobile": {
      "h1": { "fontSize": "32px", "lineHeight": "40px" },
      "h2": { "fontSize": "28px", "lineHeight": "36px" },
      "h3": { "fontSize": "24px", "lineHeight": "32px" },
      "h4": { "fontSize": "20px", "lineHeight": "28px" },
      "body": { "fontSize": "16px", "lineHeight": "24px" },
      "small": { "fontSize": "14px", "lineHeight": "20px" }
    },
    "tablet": {
      "h1": { "fontSize": "40px", "lineHeight": "48px" },
      "h2": { "fontSize": "32px", "lineHeight": "40px" },
      "h3": { "fontSize": "26px", "lineHeight": "34px" },
      "h4": { "fontSize": "22px", "lineHeight": "30px" },
      "body": { "fontSize": "16px", "lineHeight": "24px" },
      "small": { "fontSize": "14px", "lineHeight": "20px" }
    },
    "desktop": {
      "h1": { "fontSize": "48px", "lineHeight": "56px" },
      "h2": { "fontSize": "36px", "lineHeight": "44px" },
      "h3": { "fontSize": "24px", "lineHeight": "32px" },
      "h4": { "fontSize": "20px", "lineHeight": "28px" },
      "body": { "fontSize": "16px", "lineHeight": "24px" },
      "small": { "fontSize": "14px", "lineHeight": "20px" }
    }
  },
  "navigation": {
    "mobile": {
      "navbar": {
        "height": "64px",
        "padding": "0px 16px",
        "logoSize": "32px",
        "menuItems": "hidden",
        "hamburgerMenu": "visible"
      },
      "sidebar": {
        "width": "280px",
        "transform": "translateX(-100%)",
        "overlay": "visible",
        "position": "fixed"
      }
    },
    "tablet": {
      "navbar": {
        "height": "72px",
        "padding": "0px 24px",
        "logoSize": "40px",
        "menuItems": "visible",
        "hamburgerMenu": "hidden"
      },
      "sidebar": {
        "width": "260px",
        "transform": "translateX(0%)",
        "overlay": "hidden",
        "position": "fixed"
      }
    },
    "desktop": {
      "navbar": {
        "height": "72px",
        "padding": "0px 32px",
        "logoSize": "40px",
        "menuItems": "visible",
        "hamburgerMenu": "hidden"
      },
      "sidebar": {
        "width": "250px",
        "transform": "translateX(0%)",
        "overlay": "hidden",
        "position": "fixed"
      }
    }
  },
  "layouts": {
    "landingPage": {
      "mobile": {
        "heroSection": {
          "minHeight": "auto",
          "padding": "80px 16px",
          "contentGrid": "1fr",
          "textAlign": "center"
        },
        "featuresGrid": {
          "gridColumns": "1fr",
          "gap": "24px"
        },
        "testimonials": {
          "gridColumns": "1fr",
          "cardStyle": "vertical"
        },
        "schemesGrid": {
          "gridColumns": "1fr",
          "cardStyle": "compact"
        }
      },
      "tablet": {
        "heroSection": {
          "minHeight": "auto",
          "padding": "100px 24px",
          "contentGrid": "1fr 1fr",
          "textAlign": "left"
        },
        "featuresGrid": {
          "gridColumns": "1fr 1fr",
          "gap": "32px"
        },
        "testimonials": {
          "gridColumns": "1fr 1fr",
          "cardStyle": "horizontal"
        },
        "schemesGrid": {
          "gridColumns": "1fr 1fr",
          "cardStyle": "default"
        }
      },
      "desktop": {
        "heroSection": {
          "minHeight": "100vh",
          "padding": "0px 32px",
          "contentGrid": "1fr 1fr",
          "textAlign": "left"
        },
        "featuresGrid": {
          "gridColumns": "1fr 1fr 1fr 1fr",
          "gap": "32px"
        },
        "testimonials": {
          "gridColumns": "1fr 1fr 1fr",
          "cardStyle": "horizontal"
        },
        "schemesGrid": {
          "gridColumns": "1fr 1fr 1fr",
          "cardStyle": "default"
        }
      }
    },
    "dashboard": {
      "mobile": {
        "mainLayout": {
          "sidebarMargin": "0px",
          "topbarMargin": "64px"
        },
        "contentGrid": {
          "gridColumns": "1fr",
          "gap": "16px"
        },
        "statsCards": {
          "gridColumns": "1fr",
          "cardStyle": "compact"
        },
        "dataTable": {
          "view": "card",
          "pagination": "bottom"
        }
      },
      "tablet": {
        "mainLayout": {
          "sidebarMargin": "260px",
          "topbarMargin": "0px"
        },
        "contentGrid": {
          "gridColumns": "1fr 1fr",
          "gap": "24px"
        },
        "statsCards": {
          "gridColumns": "1fr 1fr",
          "cardStyle": "default"
        },
        "dataTable": {
          "view": "table",
          "pagination": "bottom"
        }
      },
      "desktop": {
        "mainLayout": {
          "sidebarMargin": "250px",
          "topbarMargin": "0px"
        },
        "contentGrid": {
          "gridColumns": "repeat(auto-fit, minmax(300px, 1fr))",
          "gap": "32px"
        },
        "statsCards": {
          "gridColumns": "repeat(auto-fit, minmax(250px, 1fr))",
          "cardStyle": "default"
        },
        "dataTable": {
          "view": "table",
          "pagination": "bottom"
        }
      }
    },
    "registrationWizard": {
      "mobile": {
        "container": {
          "padding": "16px"
        },
        "stepper": {
          "variant": "vertical",
          "compact": true
        },
        "formLayout": {
          "singleColumn": true,
          "fieldSpacing": "20px"
        },
        "actions": {
          "layout": "vertical",
          "buttonWidth": "full"
        }
      },
      "tablet": {
        "container": {
          "padding": "24px"
        },
        "stepper": {
          "variant": "horizontal",
          "compact": false
        },
        "formLayout": {
          "singleColumn": true,
          "fieldSpacing": "24px"
        },
        "actions": {
          "layout": "horizontal",
          "buttonWidth": "auto"
        }
      },
      "desktop": {
        "container": {
          "padding": "32px",
          "maxWidth": "900px"
        },
        "stepper": {
          "variant": "horizontal",
          "compact": false
        },
        "formLayout": {
          "twoColumns": true,
          "fieldSpacing": "24px"
        },
        "actions": {
          "layout": "horizontal",
          "buttonWidth": "auto"
        }
      }
    }
  },
  "components": {
    "button": {
      "mobile": {
        "small": { "padding": "8px 16px", "fontSize": "12px" },
        "medium": { "padding": "12px 24px", "fontSize": "14px" },
        "large": { "padding": "16px 32px", "fontSize": "16px" }
      },
      "tablet": {
        "small": { "padding": "10px 18px", "fontSize": "13px" },
        "medium": { "padding": "14px 28px", "fontSize": "15px" },
        "large": { "padding": "18px 36px", "fontSize": "17px" }
      },
      "desktop": {
        "small": { "padding": "12px 20px", "fontSize": "14px" },
        "medium": { "padding": "16px 32px", "fontSize": "16px" },
        "large": { "padding": "20px 40px", "fontSize": "18px" }
      }
    },
    "card": {
      "mobile": {
        "padding": "16px",
        "borderRadius": "8px",
        "marginBottom": "16px"
      },
      "tablet": {
        "padding": "20px",
        "borderRadius": "10px",
        "marginBottom": "20px"
      },
      "desktop": {
        "padding": "24px",
        "borderRadius": "12px",
        "marginBottom": "24px"
      }
    },
    "modal": {
      "mobile": {
        "width": "95vw",
        "maxHeight": "90vh",
        "margin": "16px",
        "borderRadius": "12px"
      },
      "tablet": {
        "width": "80vw",
        "maxHeight": "85vh",
        "margin": "24px",
        "borderRadius": "14px"
      },
      "desktop": {
        "width": "600px",
        "maxHeight": "80vh",
        "margin": "auto",
        "borderRadius": "16px"
      }
    }
  },
  "spacing": {
    "mobile": {
      "section": "48px",
      "subsection": "32px",
      "component": "24px",
      "element": "16px",
      "tight": "8px"
    },
    "tablet": {
      "section": "64px",
      "subsection": "48px",
      "component": "32px",
      "element": "20px",
      "tight": "12px"
    },
    "desktop": {
      "section": "80px",
      "subsection": "64px",
      "component": "40px",
      "element": "24px",
      "tight": "16px"
    }
  },
  "images": {
    "responsiveBreakpoints": {
      "mobile": { "maxWidth": "767px", "quality": 80 },
      "tablet": { "minWidth": "768px", "maxWidth": "1023px", "quality": 85 },
      "desktop": { "minWidth": "1024px", "quality": 90 }
    },
    "aspectRatios": {
      "hero": "16/9",
      "card": "4/3",
      "profile": "1/1",
      "thumbnail": "16/9"
    }
  },
  "testing": {
    "viewports": [
      { "width": 375, "height": 667, "name": "iPhone X" },
      { "width": 414, "height": 896, "name": "iPhone 11" },
      { "width": 768, "height": 1024, "name": "iPad" },
      { "width": 1024, "height": 768, "name": "iPad Landscape" },
      { "width": 1440, "height": 900, "name": "Desktop" },
      { "width": 1920, "height": 1080, "name": "Large Desktop" }
    ]
  }
}