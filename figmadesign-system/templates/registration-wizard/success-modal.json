{
  "componentName": "Success Modal",
  "description": "Success confirmation modal after registration completion",
  "variants": {
    "success": {
      "container": {
        "position": "fixed",
        "top": "0px",
        "left": "0px",
        "right": "0px",
        "bottom": "0px",
        "backgroundColor": "rgba(0, 0, 0, 0.6)",
        "display": "flex",
        "alignItems": "center",
        "justifyContent": "center",
        "zIndex": "10000"
      },
      "modal": {
        "backgroundColor": "#FFFFFF",
        "borderRadius": "16px",
        "maxWidth": "500px",
        "width": "90%",
        "maxHeight": "90vh",
        "overflow": "auto",
        "boxShadow": "0px 20px 25px -5px rgba(0, 0, 0, 0.1), 0px 10px 10px -5px rgba(0, 0, 0, 0.04)",
        "position": "relative",
        "animation": "scaleIn 0.3s ease-out"
      }
    }
  },
  "content": {
    "header": {
      "iconContainer": {
        "width": "80px",
        "height": "80px",
        "backgroundColor": "#E6F4EA",
        "borderRadius": "50%",
        "display": "flex",
        "alignItems": "center",
        "justifyContent": "center",
        "margin": "0px auto 24px auto"
      },
      "icon": {
        "width": "40px",
        "height": "40px",
        "color": "#4CAF50"
      }
    },
    "title": {
      "text": "Pendaftaran Berhasil!",
      "fontFamily": "Poppins",
      "fontSize": "28px",
      "fontWeight": "600",
      "color": "#1A1A1A",
      "textAlign": "center",
      "margin": "0px 0px 16px 0px"
    },
    "subtitle": {
      "text": "Terima kasih telah mendaftar. Tim kami akan memverifikasi data Anda dalam 2-3 hari kerja.",
      "fontFamily": "Roboto",
      "fontSize": "16px",
      "fontWeight": "400",
      "color": "#5F6368",
      "textAlign": "center",
      "lineHeight": "1.6",
      "margin": "0px 0px 32px 0px"
    }
  },
  "registrationDetails": {
    "container": {
      "backgroundColor": "#F8F9FA",
      "borderRadius": "12px",
      "padding": "24px",
      "margin": "0px 24px 24px 24px"
    },
    "title": {
      "text": "Detail Pendaftaran",
      "fontFamily": "Roboto",
      "fontSize": "18px",
      "fontWeight": "600",
      "color": "#202124",
      "margin": "0px 0px 16px 0px"
    },
    "detailRow": {
      "display": "flex",
      "justifyContent": "space-between",
      "alignItems": "center",
      "padding": "8px 0px",
      "borderBottom": "1px solid #E8EAED"
    },
    "detailLabel": {
      "fontFamily": "Roboto",
      "fontSize": "14px",
      "fontWeight": "500",
      "color": "#5F6368"
    },
    "detailValue": {
      "fontFamily": "Roboto",
      "fontSize": "14px",
      "fontWeight": "600",
      "color": "#202124"
    },
    "registrationId": {
      "label": "Nomor Pendaftaran",
      "value": "REG-2024-001234"
    },
    "scheme": {
      "label": "Skema Sertifikasi",
      "value": "Junior Web Developer"
    },
    "date": {
      "label": "Tanggal Daftar",
      "value": "20 November 2024"
    },
    "status": {
      "label": "Status",
      "value": "Menunggu Verifikasi",
      "badge": "warning"
    }
  },
  "nextSteps": {
    "container": {
      "margin": "0px 24px 24px 24px"
    },
    "title": {
      "text": "Langkah Selanjutnya",
      "fontFamily": "Roboto",
      "fontSize": "16px",
      "fontWeight": "600",
      "color": "#202124",
      "margin": "0px 0px 12px 0px"
    },
    "steps": [
      {
        "number": "1",
        "text": "Verifikasi dokumen oleh tim LSP-SI (2-3 hari kerja)",
        "status": "pending"
      },
      {
        "number": "2",
        "text": "Konfirmasi jadwal asesmen via email",
        "status": "pending"
      },
      {
        "number": "3",
        "text": "Pelaksanaan asesmen sesuai jadwal",
        "status": "pending"
      }
    ]
  },
  "actions": {
    "container": {
      "display": "flex",
      "gap": "12px",
      "padding": "24px",
      "borderTop": "1px solid #E8EAED",
      "flexWrap": "wrap"
    },
    "primary": {
      "text": "Lihat Status Pendaftaran",
      "variant": "button.primary",
      "action": "navigate to /dashboard",
      "fullWidth": false
    },
    "secondary": {
      "text": "Download Bukti Pendaftaran",
      "variant": "button.outline",
      "action": "downloadRegistrationProof",
      "fullWidth": false
    },
    "close": {
      "text": "Tutup",
      "variant": "button.ghost",
      "action": "closeModal",
      "fullWidth": true
    }
  },
  "contactInfo": {
    "container": {
      "backgroundColor": "#E8F0FE",
      "borderRadius": "8px",
      "padding": "16px",
      "margin": "24px"
    },
    "title": {
      "text": "Butuh Bantuan?",
      "fontFamily": "Roboto",
      "fontSize": "14px",
      "fontWeight": "600",
      "color": "#0A3D62",
      "margin": "0px 0px 8px 0px"
    },
    "text": {
      "text": "Hubungi tim kami melalui email atau WhatsApp untuk pertanyaan lebih lanjut.",
      "fontFamily": "Roboto",
      "fontSize": "13px",
      "fontWeight": "400",
      "color": "#5F6368",
      "margin": "0px"
    },
    "contactButtons": {
      "email": {
        "text": "lsp-si@example.com",
        "icon": "email",
        "action": "mailto:lsp-si@example.com"
      },
      "whatsapp": {
        "text": "+62 812-3456-7890",
        "icon": "whatsapp",
        "action": "https://wa.me/6281234567890"
      }
    }
  },
  "closeButton": {
    "position": "absolute",
    "top": "16px",
    "right": "16px",
    "width": "32px",
    "height": "32px",
    "backgroundColor": "transparent",
    "borderColor": "transparent",
    "borderRadius": "8px",
    "display": "flex",
    "alignItems": "center",
    "justifyContent": "center",
    "cursor": "pointer",
    "hoverBackgroundColor": "#F5F6FA",
    "icon": {
      "width": "20px",
      "height": "20px",
      "color": "#5F6368"
    }
  },
  "responsive": {
    "mobile": {
      "modal": {
        "width": "95%",
        "margin": "16px"
      },
      "actions": {
        "container": {
          "flexDirection": "column"
        },
        "primary": {
          "fullWidth": true
        },
        "secondary": {
          "fullWidth": true
        }
      },
      "contactInfo": {
        "container": {
          "margin": "16px"
        }
      }
    }
  },
  "animations": {
    "entrance": {
      "container": "fadeIn 0.3s ease-out",
      "modal": "scaleIn 0.3s ease-out",
      "icon": "bounceIn 0.6s ease-out",
      "content": "fadeInUp 0.4s ease-out 0.2s"
    },
    "exit": {
      "container": "fadeOut 0.3s ease-out",
      "modal": "scaleOut 0.3s ease-out"
    }
  }
}