      },
      "recentAssessments": {
        "componentName": "Recent Assessments Table",
        "title": "Asesmen Terbaru",
        "container": {
          "backgroundColor": "#FFFFFF",
          "borderRadius": "12px",
          "padding": "24px",
          "boxShadow": "0px 2px 8px rgba(0, 0, 0, 0.08)"
        },
        "table": {
          "headers": ["Tanggal", "Peserta", "Skema", "Asesor", "Hasil"],
          "rows": [
            {
              "date": "28 Nov 2024",
              "participant": "John Doe",
              "scheme": "Web Dev",
              "assessor": "Budi Santoso",
              "result": {
                "status": "kompeten",
                "badge": "success"
              }
            },
            {
              "date": "27 Nov 2024",
              "participant": "Jane Smith",
              "scheme": "Mobile Dev",
              "assessor": "Ahmad Wijaya",
              "result": {
                "status": "belum kompeten",
                "badge": "error"
              }
            }
          ]
        }
      }
    },
    "activityFeed": {
      "componentName": "Activity Feed",
      "title": "Aktivitas Terkini",
      "container": {
        "backgroundColor": "#FFFFFF",
        "borderRadius": "12px",
        "padding": "24px",
        "boxShadow": "0px 2px 8px rgba(0, 0, 0, 0.08)",
        "maxHeight": "400px",
        "overflow": "auto"
      },
      "activities": [
        {
          "type": "registration",
          "user": "John Doe",
          "action": "Mendaftar skema Junior Web Developer",
          "time": "5 menit yang lalu",
          "icon": "person_add",
          "color": "#4CAF50"
        },
        {
          "type": "verification",
          "user": "Admin",
          "action": "Memverifikasi dokumen Jane Smith",
          "time": "1 jam yang lalu",
          "icon": "fact_check",
          "color": "#2196F3"
        },
        {
          "type": "schedule",
          "user": "Admin",
          "action": "Menjadwalkan asesmen untuk 5 peserta",
          "time": "2 jam yang lalu",
          "icon": "event",
          "color": "#FFC107"
        },
        {
          "type": "result",
          "user": "Asesor",
          "action": "Menginput hasil asesmen",
          "time": "3 jam yang lalu",
          "icon": "assessment",
          "color": "#9C27B0"
        }
      ],
      "activityItem": {
        "display": "flex",
        "alignItems": "flex-start",
        "gap": "12px",
        "padding": "12px 0px",
        "borderBottom": "1px solid #F5F6FA"
      },
      "icon": {
        "width": "36px",
        "height": "36px",
        "borderRadius": "50%",
        "display": "flex",
        "alignItems": "center",
        "justifyContent": "center",
        "flexShrink": 0
      },
      "content": {
        "flex": "1"
      },
      "action": {
        "fontFamily": "Roboto",
        "fontSize": "14px",
        "fontWeight": "500",
        "color": "#202124",
        "marginBottom": "4px"
      },
      "user": {
        "fontFamily": "Roboto",
        "fontSize": "13px",
        "fontWeight": "600",
        "color": "#0A3D62"
      },
      "time": {
        "fontFamily": "Roboto",
        "fontSize": "12px",
        "fontWeight": "400",
        "color": "#9AA0A6"
      }
    }
  },
