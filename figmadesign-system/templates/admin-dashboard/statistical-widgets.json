  "responsive": {
    "mobile": {
      "statsCards": {
        "gridTemplateColumns": "1fr",
        "gap": "16px"
      },
      "chartWidgets": {
        "container": {
          "padding": "16px"
        },
        "chart": {
          "height": "250px"
        }
      },
      "tableWidgets": {
        "tableView": "compact"
      }
    },
    "tablet": {
      "statsCards": {
        "gridTemplateColumns": "repeat(2, 1fr)"
      },
      "chartWidgets": {
        "chart": {
          "height": "275px"
        }
      }
    }
  }
}