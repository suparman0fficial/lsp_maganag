{
  "componentName": "Assessor Management",
  "description": "CRUD interface for managing assessor data and assignments",
  "layout": {
    "container": {
      "maxWidth": "1400px",
      "margin": "0px auto",
      "padding": "32px"
    }
  },
  "header": {
    "titleSection": {
      "title": {
        "text": "Data Asesor",
        "fontFamily": "Poppins",
        "fontSize": "32px",
        "fontWeight": "600",
        "color": "#1A1A1A",
        "marginBottom": "8px"
      },
      "subtitle": {
        "text": "Kelola data asesor dan alokasi penugasan",
        "fontFamily": "Roboto",
        "fontSize": "16px",
        "fontWeight": "400",
        "color": "#5F6368"
      }
    },
    "actionsSection": {
      "buttons": [
        {
          "text": "Import Data",
          "variant": "button.outline",
          "icon": "upload_file",
          "action": "importAssessors"
        },
        {
          "text": "Export Data",
          "variant": "button.outline",
          "icon": "download",
          "action": "exportAssessors"
        },
        {
          "text": "Tambah Asesor",
          "variant": "button.primary",
          "icon": "add",
          "action": "addAssessor"
        }
      ]
    }
  },
  "statsOverview": {
    "container": {
      "display": "grid",
      "gridTemplateColumns": "repeat(auto-fit, minmax(250px, 1fr))",
      "gap": "24px",
      "marginBottom": "32px"
    },
    "cards": [
      {
        "title": "Total Asesor",
        "value": "24",
        "change": "+3 bulan ini",
        "changeType": "positive",
        "icon": "person_search",
        "color": "#4285F4"
      },
      {
        "title": "Asesor Aktif",
        "value": "18",
        "change": "75%",
        "changeType": "neutral",
        "icon": "verified_user",
        "color": "#34A853"
      },
      {
        "title": "Asesor Tersedia",
        "value": "8",
        "change": "Hari ini",
        "changeType": "neutral",
        "icon": "event_available",
        "color": "#FBBC04"
      },
      {
        "title": "Penugasan Bulan Ini",
        "value": "45",
        "change": "+12 dari bulan lalu",
        "changeType": "positive",
        "icon": "assignment",
        "color": "#EA4335"
      }
    ]
  },
  "filtersAndSearch": {
    "container": {
      "backgroundColor": "#FFFFFF",
      "borderRadius": "12px",
      "padding": "24px",
      "boxShadow": "0px 1px 3px rgba(0, 0, 0, 0.1)",
      "marginBottom": "24px"
    },
    "searchSection": {
      "searchBar": {
        "width": "100%",
        "maxWidth": "400px",
        "placeholder": "Cari berdasarkan nama, email, atau nomor sertifikat...",
        "icon": "search"
      }
    },
    "filtersSection": {
      "filters": [
        {
          "name": "status",
          "label": "Status",
          "type": "select",
          "options": [
            { "value": "", "label": "Semua Status" },
            { "value": "active", "label": "Aktif" },
            { "value": "inactive", "label": "Tidak Aktif" },
            { "value": "pending", "label": "Menunggu Verifikasi" },
            { "value": "suspended", "label": "Diskors" }
          ]
        },
        {
          "name": "expertise",
          "label": "Bidang Keahlian",
          "type": "multi-select",
          "options": [
            { "value": "web", "label": "Web Development" },
            { "value": "mobile", "label": "Mobile Development" },
            { "value": "backend", "label": "Backend Development" },
            { "value": "uiux", "label": "UI/UX Design" },
            { "value": "devops", "label": "DevOps" }
          ]
        },
        {
          "name": "availability",
          "label": "Ketersediaan",
          "type": "checkbox-group",
          "options": [
            { "value": "available", "label": "Tersedia" },
            { "value": "busy", "label": "Sibuk" },
            { "value": "on_leave", "label": "Cuti" }
          ]
        }
      ]
    }
  },
