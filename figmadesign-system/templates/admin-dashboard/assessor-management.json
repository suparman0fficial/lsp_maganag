        "label": "Dokumen",
        "content": "documentsTab"
      }
    ]
  },
  "assignmentCalendar": {
    "componentName": "Assessor Assignment Calendar",
    "features": [
      "Monthly view with color-coded assignments",
      "Conflict detection for overlapping schedules",
      "Quick assignment creation",
      "Availability status indicators",
      "Assignment details on hover/click"
    ]
  },
  "bulkActions": {
    "actions": [
      {
        "text": "Aktifkan",
        "variant": "button.outline.success",
        "icon": "check_circle",
        "action": "bulkActivate"
      },
      {
        "text": "Nonaktifkan",
        "variant": "button.outline.warning",
        "icon": "block",
        "action": "bulkDeactivate"
      },
      {
        "text": "Hapus",
        "variant": "button.outline.error",
        "icon": "delete",
        "action": "bulkDelete"
      },
      {
        "text": "Export",
        "variant": "button.outline",
        "icon": "download",
        "action": "bulkExport"
      }
    ]
  },
  "responsive": {
    "mobile": {
      "statsOverview": {
        "gridTemplateColumns": "repeat(2, 1fr)"
      },
      "assessorsTable": {
        "tableView": "cards",
        "cardStructure": {
          "header": {
            "avatar": "medium",
            "name": true,
            "status": true,
            "availability": true
          },
          "details": {
            "expertise": true,
            "contact": true,
            "assignments": true
          }
        }
      },
      "assessorForm": {
        "formSections": {
          "singleColumn": true
        },
        "container": {
          "padding": "16px"
        }
      }
    }
  }
}