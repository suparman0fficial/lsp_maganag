  "assessorForm": {
    "componentName": "Assessor Form Modal",
    "container": {
      "maxWidth": "800px",
      "maxHeight": "90vh",
      "overflow": "auto"
    },
    "mode": "create", // or "edit"
    "header": {
      "title": "Tambah Asesor Baru",
      "subtitle": "Lengkapi data asesor yang akan ditambahkan"
    },
    "form": {
      "sections": [
        {
          "title": "Data Pribadi",
          "fields": [
            {
              "name": "fullName",
              "label": "Nama Lengkap",
              "type": "text",
              "placeholder": "Masukkan nama lengkap",
              "required": true,
              "validation": "min:3|max:100"
            },
            {
              "name": "certificateNumber",
              "label": "Nomor Sertifikat Asesor",
              "type": "text",
              "placeholder": "Contoh: ASE-001/2024",
              "required": true,
              "validation": "unique"
            },
            {
              "name": "nik",
              "label": "NIK",
              "type": "text",
              "placeholder": "16 digit NIK",
              "required": true,
              "validation": "min:16|max:16|numeric"
            },
            {
              "name": "birthPlace",
              "label": "Tempat Lahir",
              "type": "text",
              "required": true
            },
            {
              "name": "birthDate",
              "label": "Tanggal Lahir",
              "type": "date",
              "required": true,
              "validation": "age:25"
            },
            {
              "name": "gender",
              "label": "Jenis Kelamin",
              "type": "radio",
              "options": [
                { "value": "L", "label": "Laki-laki" },
                { "value": "P", "label": "Perempuan" }
              ],
              "required": true
            },
            {
              "name": "address",
              "label": "Alamat Lengkap",
              "type": "textarea",
              "required": true,
              "rows": 3
            }
          ]
        },
        {
          "title": "Kontak",
          "fields": [
            {
              "name": "email",
              "label": "Email",
              "type": "email",
              "placeholder": "email@example.com",
              "required": true,
              "validation": "email|unique"
            },
            {
              "name": "phone",
              "label": "Nomor Telepon",
              "type": "tel",
              "placeholder": "+62 8xx-xxxx-xxxx",
              "required": true,
              "validation": "phone|unique"
            },
            {
              "name": "emergencyContact",
              "label": "Kontak Darurat",
              "type": "text",
              "placeholder": "Nama dan nomor telepon"
            }
          ]
        },
        {
          "title": "Keahlian",
          "fields": [
            {
              "name": "primaryExpertise",
              "label": "Bidang Keahlian Utama",
              "type": "select",
              "required": true,
              "options": [
                { "value": "web", "label": "Web Development" },
                { "value": "mobile", "label": "Mobile Development" },
                { "value": "backend", "label": "Backend Development" },
                { "value": "uiux", "label": "UI/UX Design" },
                { "value": "devops", "label": "DevOps" }
              ]
            },
            {
              "name": "secondaryExpertise",
              "label": "Keahlian Pendukung",
              "type": "multi-select",
              "options": [
                { "value": "html", "label": "HTML/CSS" },
                { "value": "javascript", "label": "JavaScript" },
                { "value": "react", "label": "React" },
                { "value": "vue", "label": "Vue.js" },
                { "value": "angular", "label": "Angular" },
                { "value": "nodejs", "label": "Node.js" },
                { "value": "python", "label": "Python" },
                { "value": "java", "label": "Java" },
                { "value": "android", "label": "Android" },
                { "value": "ios", "label": "iOS" }
              ]
            },
            {
              "name": "experience",
              "label": "Pengalaman (Tahun)",
              "type": "number",
              "min": 0,
              "max": 50,
              "required": true
            },
            {
              "name": "certifications",
              "label": "Sertifikat Tambahan",
              "type": "dynamic-fields",
              "addField": "Tambah Sertifikat",
              "fieldTemplate": {
                "name": "string",
                "issuer": "string",
                "date": "date",
                "certificate": "file"
              }
            }
          ]
        },
        {
          "title": "Dokumen",
          "fields": [
            {
              "name": "photo",
              "label": "Foto Asesor",
              "type": "file",
              "accept": ".jpg,.jpeg,.png",
              "required": true,
              "preview": true,
              "description": "Format: JPG/PNG, ukuran passport"
            },
            {
              "name": "cv",
              "label": "Curriculum Vitae",
              "type": "file",
              "accept": ".pdf",
              "required": true,
              "description": "Format: PDF, maks 5MB"
            },
            {
              "name": "assessorCertificate",
              "label": "Sertifikat Asesor BNSP",
              "type": "file",
              "accept": ".pdf",
              "required": true,
              "description": "Format: PDF, maks 5MB"
            },
            {
              "name": "portfolio",
              "label": "Portfolio/Portofolio",
              "type": "file",
              "accept": ".pdf,.zip",
              "required": false,
              "description": "Format: PDF/ZIP, maks 10MB"
            }
          ]
        },
        {
          "title": "Pengaturan Akun",
          "fields": [
            {
              "name": "status",
              "label": "Status Akun",
              "type": "radio",
              "options": [
                { "value": "active", "label": "Aktif" },
                { "value": "inactive", "label": "Tidak Aktif" }
              ],
              "required": true,
              "default": "active"
            },
            {
              "name": "availability",
              "label": "Ketersediaan",
              "type": "radio",
              "options": [
                { "value": "available", "label": "Tersedia" },
                { "value": "busy", "label": "Sibuk" },
                { "value": "on_leave", "label": "Cuti" }
              ],
              "required": true,
              "default": "available"
            },
            {
              "name": "generateAccount",
              "label": "Buat Akun Login",
              "type": "checkbox",
              "description": "Secara otomatis membuat akun login untuk asesor",
              "default": true
            }
          ]
        }
      ]
    },
    "actions": [
      {
        "text": "Batal",
        "variant": "button.outline",
        "action": "cancel"
      },
      {
        "text": "Simpan Draft",
        "variant": "button.outline",
        "action": "saveDraft"
      },
      {
        "text": "Tambah Asesor",
        "variant": "button.primary",
        "action": "createAssessor"
      }
    ]
  },
