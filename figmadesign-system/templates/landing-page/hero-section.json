{
  "componentName": "Hero Section",
  "description": "Main hero section with CTA for landing page",
  "layout": {
    "container": {
      "minHeight": "100vh",
      "display": "flex",
      "alignItems": "center",
      "padding": "0px 32px",
      "position": "relative",
      "overflow": "hidden"
    },
    "content": {
      "maxWidth": "1200px",
      "margin": "0px auto",
      "display": "grid",
      "gridTemplateColumns": "1fr 1fr",
      "gap": "64px",
      "alignItems": "center"
    }
  },
  "background": {
    "primaryGradient": "linear-gradient(135deg, #0A3D62 0%, #4285F4 100%)",
    "secondaryPattern": {
      "type": "dots",
      "color": "rgba(255, 255, 255, 0.1)",
      "size": "20px",
      "spacing": "40px"
    },
    "shapes": [
      {
        "type": "circle",
        "position": "top-right",
        "size": "300px",
        "color": "rgba(255, 255, 255, 0.05)"
      },
      {
        "type": "blob",
        "position": "bottom-left",
        "size": "400px",
        "color": "rgba(255, 255, 255, 0.03)"
      }
    ]
  },
  "textContent": {
    "eyebrow": {
      "text": "🚀 Tingkatkan Karir Profesional Anda",
      "fontFamily": "Roboto",
      "fontSize": "18px",
      "fontWeight": "600",
      "color": "#E8F0FE",
      "marginBottom": "16px",
      "display": "flex",
      "alignItems": "center",
      "gap": "8px"
    },
    "headline": {
      "text": "Dapatkan Sertifikasi Profesional Bersama LSP-SI",
      "fontFamily": "Poppins",
      "fontSize": "56px",
      "fontWeight": "700",
      "lineHeight": "1.2",
      "color": "#FFFFFF",
      "margin": "0px 0px 24px 0px"
    },
    "subtitle": {
      "text": "Lembaga Sertifikasi Profesi yang terakreditasi BNSP. Wujudkan potensi terbaik Anda dengan sertifikasi yang diakui secara nasional.",
      "fontFamily": "Roboto",
      "fontSize": "20px",
      "fontWeight": "400",
      "lineHeight": "1.6",
      "color": "rgba(255, 255, 255, 0.9)",
      "margin": "0px 0px 40px 0px"
    }
  },
  "ctaButtons": {
    "container": {
      "display": "flex",
      "gap": "16px",
      "flexWrap": "wrap"
    },
    "primary": {
      "text": "Daftar Sekarang",
      "variant": "button.primary.large",
      "icon": "arrow_forward",
      "iconPosition": "right",
      "action": "navigate to /register"
    },
    "secondary": {
      "text": "Lihat Skema",
      "variant": "button.outline.large",
      "icon": "explore",
      "iconPosition": "left",
      "action": "scroll to #schemes"
    }
  },
  "stats": {
    "container": {
      "display": "flex",
      "gap": "48px",
      "marginTop": "64px"
    },
    "stat": {
      "number": {
        "fontFamily": "Poppins",
        "fontSize": "32px",
        "fontWeight": "700",
        "color": "#FFFFFF",
        "marginBottom": "4px"
      },
      "label": {
        "fontFamily": "Roboto",
        "fontSize": "16px",
        "fontWeight": "400",
        "color": "rgba(255, 255, 255, 0.8)"
      }
    }
  },
  "visualSection": {
    "container": {
      "position": "relative",
      "zIndex": "10"
    },
    "illustration": {
      "type": "vector",
      "source": "certification-illustration.svg",
      "width": "100%",
      "height": "auto",
      "alt": "Professional certification illustration"
    },
    "floatingCards": [
      {
        "position": "top-right",
        "offsetX": "20%",
        "offsetY": "-10%",
        "content": {
          "icon": "verified",
          "title": "Tersertifikasi",
          "subtitle": "BNSP"
        },
        "style": "card.elevated.small"
      },
      {
        "position": "bottom-left",
        "offsetX": "-15%",
        "offsetY": "15%",
        "content": {
          "icon": "groups",
          "title": "1000+",
          "subtitle": "Peserta"
        },
        "style": "card.elevated.small"
      }
    ]
  },
  "responsive": {
    "mobile": {
      "container": {
        "padding": "0px 16px",
        "minHeight": "auto",
        "paddingTop": "80px",
        "paddingBottom": "80px"
      },
      "content": {
        "gridTemplateColumns": "1fr",
        "gap": "40px",
        "textAlign": "center"
      },
      "headline": {
        "fontSize": "36px",
        "lineHeight": "1.3"
      },
      "subtitle": {
        "fontSize": "18px"
      },
      "ctaButtons": {
        "container": {
          "justifyContent": "center"
        }
      },
      "stats": {
        "container": {
          "justifyContent": "center",
          "gap": "32px"
        }
      },
      "floatingCards": {
        "display": "none"
      }
    },
    "tablet": {
      "container": {
        "padding": "0px 24px"
      },
      "content": {
        "gap": "48px"
      },
      "headline": {
        "fontSize": "48px"
      }
    }
  },
  "animations": {
    "entrance": {
      "textContent": {
        "animation": "fadeInUp",
        "duration": "0.8s",
        "delay": "0.2s"
      },
      "visualSection": {
        "animation": "fadeInRight",
        "duration": "0.8s",
        "delay": "0.4s"
      },
      "floatingCards": {
        "animation": "float",
        "duration": "3s",
        "repeat": "infinite"
      }
    }
  }
}