{
  "componentName": "Schedule and Results Display",
  "description": "Schedule status and assessment results components for participants",
  "scheduleStatus": {
    "componentName": "Schedule Status Cards",
    "layout": {
      "container": {
        "display": "grid",
        "gridTemplateColumns": "repeat(auto-fit, minmax(300px, 1fr))",
        "gap": "24px",
        "marginBottom": "32px"
      }
    },
    "statusCards": [
      {
        "title": "Pendaftaran",
        "status": "completed",
        "date": "20 Nov 2024",
        "icon": "how_to_reg",
        "color": "#4CAF50",
        "description": "Pendaftaran berhasil diajukan"
      },
      {
        "title": "Verifikasi Dokumen",
        "status": "in_progress",
        "date": "Est. 23 Nov 2024",
        "icon": "fact_check",
        "color": "#FFC107",
        "description": "Sedang diverifikasi oleh admin"
      },
      {
        "title": "Penjadwalan Asesmen",
        "status": "pending",
        "date": "Pending",
        "icon": "event",
        "color": "#9E9E9E",
        "description": "Menunggu konfirmasi jadwal"
      },
      {
        "title": "Pelaksanaan Asesmen",
        "status": "pending",
        "date": "Pending",
        "icon": "assignment_turned_in",
        "color": "#9E9E9E",
        "description": "Menunggu jadwal pelaksanaan"
      },
      {
        "title": "Pengumuman Hasil",
        "status": "pending",
        "date": "Pending",
        "icon": "emoji_events",
        "color": "#9E9E9E",
        "description": "Hasil akan diumumkan setelah asesmen"
      }
    ]
  },
  "upcomingSchedule": {
    "componentName": "Upcoming Assessment Schedule",
    "container": {
      "backgroundColor": "#FFFFFF",
      "borderRadius": "12px",
      "padding": "32px",
      "boxShadow": "0px 2px 8px rgba(0, 0, 0, 0.08)"
    },
    "header": {
      "title": {
        "text": "Jadwal Asesmen",
        "fontFamily": "Poppins",
        "fontSize": "20px",
        "fontWeight": "600",
        "color": "#1A1A1A",
        "marginBottom": "8px"
      },
      "subtitle": {
        "text": "Berikut adalah jadwal asesmen Anda",
        "fontFamily": "Roboto",
        "fontSize": "14px",
        "fontWeight": "400",
        "color": "#5F6368",
        "marginBottom": "24px"
      }
    },
    "scheduleCards": [
      {
        "scheme": "Junior Web Developer",
        "code": "SK.WEB.001",
        "date": "28 November 2024",
        "time": "09:00 - 12:00 WIB",
        "location": "LSP-SI Training Center, Jakarta",
        "assessor": "Budi Santoso, S.Kom",
        "room": "Lab Komputer 1",
        "status": "confirmed",
        "actions": ["view-details", "download-ticket"]
      }
    ],
    "scheduleCardStructure": {
      "header": {
        "schemeTitle": {
          "fontFamily": "Poppins",
          "fontSize": "18px",
          "fontWeight": "600",
          "color": "#1A1A1A"
        },
        "schemeCode": {
          "fontFamily": "Roboto",
          "fontSize": "14px",
          "fontWeight": "500",
          "color": "#0A3D62",
          "backgroundColor": "#E8F0FE",
          "padding": "4px 8px",
          "borderRadius": "4px"
        },
        "statusBadge": {
          "variant": "badge.success",
          "text": "Dikonfirmasi"
        }
      },
      "details": {
        "section": {
          "display": "grid",
          "gridTemplateColumns": "1fr 1fr",
          "gap": "16px",
          "margin": "16px 0px"
        },
        "detailItem": {
          "label": {
            "fontFamily": "Roboto",
            "fontSize": "12px",
            "fontWeight": "500",
            "color": "#5F6368",
            "textTransform": "uppercase",
            "letterSpacing": "0.5px"
          },
          "value": {
            "fontFamily": "Roboto",
            "fontSize": "14px",
            "fontWeight": "500",
            "color": "#202124"
          }
        }
      },
      "footer": {
        "actions": {
          "display": "flex",
          "gap": "12px",
          "marginTop": "16px",
          "justifyContent": "flex-end"
        }
      }
    }
  },
  "assessmentTimeline": {
    "componentName": "Assessment Timeline",
    "container": {
      "backgroundColor": "#FFFFFF",
